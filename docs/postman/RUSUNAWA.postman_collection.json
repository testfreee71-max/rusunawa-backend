      "name": "01 Auth and Profile",
      "item": [
        {
          "name": "01 Register valid",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{base_url}}/register",
            "auth": {
              "type": "noauth"
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Mahasiswa Postman\",\n  \"email\": \"{{test_email}}\",\n  \"nim\": \"{{test_nim}}\",\n  \"study_program\": \"Informatika\",\n  \"password\": \"{{test_password}}\",\n  \"password_confirmation\": \"{{test_password}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const id = Date.now().toString() + Math.floor(Math.random()*1000).toString();",
                  "pm.collectionVariables.set(\"test_email\", \"postman\"+id+\"@example.test\");",
                  "pm.collectionVariables.set(\"test_nim\", \"PM\"+id);",
                  "pm.collectionVariables.unset(\"token\");"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 201\", () => pm.response.to.have.status(201));",
                  "const j = pm.response.json();",
                  "pm.test(\"Format respons standar\", () => { pm.expect(j).to.include.keys(\"status\", \"message\", \"data\"); pm.expect(j.status).to.eql(\"success\"); });",
                  "function sensitive(x) { return x && typeof x === \"object\" && Object.keys(x).some(k => [\"password\",\"remember_token\",\"password_confirmation\"].includes(k) || sensitive(x[k])); }",
                  "pm.test(\"Tidak membocorkan data sensitif\", () => pm.expect(!!sensitive(j.data)).to.eql(false));",
                  "pm.test(\"Token tersedia\", () => pm.expect(j.data.token).to.be.a(\"string\").and.not.empty);",
                  "if (pm.response.code < 300 && j.data?.token) pm.collectionVariables.set(\"token\", j.data.token);"
                ]
              }
            }
          ]
        },
